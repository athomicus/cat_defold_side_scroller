-- ctr +  alt  + i 
local game_state = require("main.game_state")
local LEFT = hash("left")
local RIGHT = hash("right")
local UP = hash("up")

local GRAVITY = -1400
local MOVE_SPEED = 230
local JUMP_SPEED = 400
local MAX_FALL_SPEED = -900

local JUMP_ANIM = hash("jump")
local IDLE_ANIM = hash("idle")
local FORCED_RUN_TIME = 0.2   -- ile sekund kot sam biegnie w prawo po trafieniu

local apply_correction --Func
local play_animation --Func



function init(self)
	self.forced_run = 0
	msg.post("/hud#hud", "set_deaths", { deaths_count = game_state.deaths })
	--self.deaths = 0
	--print("init_started")
	self.correction = vmath.vector3()
	self.left = false
	self.right = false
	self.grounded = false
	self.touching_wall = false
	self.velocity = vmath.vector3()
	self.animation = nil
	self.active = true
	msg.post(".", "acquire_input_focus")
	play_animation(self, IDLE_ANIM)
end

function update(self, dt)
	print("kot:", go.get_position())
	if not self.active then
		return
	end

	local direction = 0

	if self.forced_run > 0 then
		-- po trafieniu: biegnij w prawo jak przy wcisnietym klawiszu
		self.forced_run = self.forced_run - dt
		direction = 1
	else
		
		if self.left then
			direction = direction - 1
		end

		if self.right then
			direction = direction + 1
		end
	end
	self.velocity.x = direction * MOVE_SPEED
	self.velocity.y = math.max(self.velocity.y + GRAVITY * dt, MAX_FALL_SPEED)

	local position = go.get_position()
	position = position + self.velocity * dt
	go.set_position(position)

	if direction < 0 then
		sprite.set_hflip("#sprite", true)
	elseif direction > 0 then
		sprite.set_hflip("#sprite", false)
	end

	if self.grounded then
		play_animation(self, IDLE_ANIM)
	else
		play_animation(self, JUMP_ANIM)
	end

	self.grounded = false
	self.touching_wall = false
	self.correction = vmath.vector3()
end

function on_input(self, action_id, action)
	if action_id == LEFT then
		if action.pressed then
			self.left = true
		elseif action.released then
			self.left = false
		end

	elseif action_id == RIGHT then
		if action.pressed then
			self.right = true
		elseif action.released then
			self.right = false
		end

	elseif action_id == UP and action.pressed then
		-- Skok tylko gdy stoi lub spada.
		-- Nie skacze, gdy leci już w górę.
		if self.grounded and self.velocity.y <= 0 and self.active then
			self.velocity.y = JUMP_SPEED
			self.grounded = false
		end
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("hit") then
		go.set("#sprite", "tint", vmath.vector4(1, 0.3, 0.3, 1))
		go.animate("#sprite", "tint.w", go.PLAYBACK_LOOP_PINGPONG, 0.2, go.EASING_LINEAR, 0.1)
		-- puchniecie sprite'a i powrot
		go.animate("#sprite", "scale", go.PLAYBACK_ONCE_PINGPONG,vmath.vector3(1.6, 1.6, 1), go.EASING_OUTQUAD, 0.2)

		game_state.deaths = game_state.deaths + 1
		msg.post("/hud#hud", "set_deaths", { deaths_count = game_state.deaths })
		
		--powinno dzialac tylko dla bariery przesuniecie kota w prawo
		if sender.path == hash("/barrier") then
			self.forced_run = FORCED_RUN_TIME
		else
			-- trafienie od czegoś innego niż bariera (np. zębatki) = śmierć
			msg.post("/splatter#splatter", "burst", { pos = go.get_position() })
		end

		
		-- po 1 sekundzie wylacz mruganie
		timer.delay(0.2, false, 
		function()
			go.cancel_animations("#sprite", "tint.w")          -- stop petli
			go.set("#sprite", "tint", vmath.vector4(1, 1, 1, 1)) -- normalny kolor
		end)

	end
	--jesli nie ma kolizji ze sciana i distance to po prostu wyskocz 
	
	if message_id ~= hash("contact_point_response") then
		return
	end

	if not self.active then --gdy kot nie zyje wyjdz bo kontak z fizyka jest dalej 
		return
	end

	local normal = message.normal
	local is_floor = normal.y > 0.7
	local is_wall = math.abs(normal.x) > 0.7
	local is_ceiling = normal.y < -0.7

	if message.distance > 0 then
		apply_correction(self, message)
	end

	if is_wall then
		self.touching_wall = true

		-- Zatrzymaj ruch tylko wtedy, gdy prowadzi w ścianę.
		if self.velocity.x * normal.x < 0 then
			self.velocity.x = 0
		end
	end

	if is_floor and self.velocity.y <= 0 then
		self.grounded = true
		self.velocity.y = 0
	end

	if is_ceiling and self.velocity.y > 0 then
		self.velocity.y = 0
	end
end


	function apply_correction(self, message)
		local normal = message.normal
		local proj = vmath.dot(self.correction, normal)
		local remaining = message.distance - proj

		-- Nie cofaj korekcji wykonanej dla poprzednich kontaktów.
		if remaining > 0 then
			local comp = remaining * normal
			self.correction = self.correction + comp
			go.set_position(go.get_position() + comp)
		end
	end



function play_animation(self, animation)
	if self.animation == animation then
		return
	end

	self.animation = animation
	sprite.play_flipbook("#sprite", animation)
end














